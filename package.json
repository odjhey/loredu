{
  "name": "@loredu/workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p packages/kernel && tsc -p packages/store-plainfile && tsc -p packages/cli && tsc -p tests",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun run --filter '@loredu/cli' build",
    "spell": "cspell --no-progress \"docs/**/*.md\" \"*.md\" \".agents/**/*.md\" \".github/**/*.md\"",
    "check:docs": "bun docs/scripts/check-docs.mjs",
    "check:catalog": "bun docs/scripts/check-catalog.mjs",
    "check:gates": "bun docs/scripts/check-selftest.mjs",
    "check:kernel-capabilities": "bun scripts/check-kernel-capabilities.ts",
    "check:workspace-boundaries": "bun scripts/check-workspace-boundaries.ts",
    "check:boundaries": "bun run check:kernel-capabilities && bun run check:workspace-boundaries"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@loredu/kernel": "workspace:*",
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.3",
    "cspell": "^9.2.1"
  }
}
