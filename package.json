{
  "name": "@loredu/workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p packages/kernel && tsc -p packages/store-plainfile && tsc -p packages/cli && tsc -p tests",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun run --filter '@loredu/cli' build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
