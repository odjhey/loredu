{
  "name": "@loredu/workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun scripts/run-with-watchdog.ts 180 bun test",
    "typecheck": "tsc -p packages/kernel && tsc -p packages/store-plainfile && tsc -p packages/cli && tsc -p tests",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun run --filter '@loredu/cli' build",
    "spell": "cspell --no-progress \"docs/**/*.md\" \"*.md\" \".agents/**/*.md\" \".github/**/*.md\"",
    "check:docs": "bun docs/scripts/check-docs.mjs",
    "check:catalog": "bun docs/scripts/check-catalog.mjs",
    "check:gates": "bun docs/scripts/check-selftest.mjs",
    "check:boundaries": "bun scripts/run-with-watchdog.ts 60 bun scripts/check-workspace-boundaries.ts",
    "test:boundaries": "bun scripts/run-with-watchdog.ts 60 bun test tests/workspace-structure.test.ts"
  },
  "dependencies": {
    "@loredu/kernel": "workspace:*",
    "@loredu/store-plainfile": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.3",
    "cspell": "^9.2.1"
  }
}
