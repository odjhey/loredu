{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // Code only. Markdown is hand-authored — contract tables and prose stay
    // hand-shaped (ADR 0012) — and Biome does not format it anyway.
    //
    // `docs/scripts/**` IS included: those are the docs gate's own tooling, and
    // code gets linted wherever it lives. They stay zero-dependency so they run
    // under bare node before `bun install`; Biome only shapes them.
    "includes": ["**", "!**/*.md", "!**/dist", "!**/node_modules", "!bun.lock"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useImportType": "error",
        "noParameterAssign": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": { "enabled": true }
  }
}
